# DevOps Orchestra — copy to .env and fill in values (never commit .env)

# --- Slack (required for coordinator) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token
SLACK_COMMAND_CHANNEL_ID=C0123456789
SLACK_PIPELINE_LOGS_CHANNEL_ID=C0123456789
# Optional: incoming webhook for pipeline logs channel instead of chat.postMessage
# SLACK_PIPELINE_LOGS_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Jira (Test agent use-case tool) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your-api-token
JIRA_EMAIL=you@example.com

# --- Default repo (optional; pipeline can pass repo URL from Slack) ---
DEFAULT_REPO_URL=https://github.com/org/repo.git

# --- Paths ---
REPO_BASE_PATH=/tmp/gitops_repos

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- LLM (Groq — failure suggestions, agents) ---
GROQ_API_KEY=gsk_your_groq_key

# --- GitOps tool server (clone, validate, license, repo size) ---
TOOL_SERVER_URL=http://localhost:8001/invoke

# --- SonarCloud (recommended) or self-hosted SonarQube ---
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=your_sonar_token
SONAR_ORGANIZATION=your-org
SONAR_PROJECT_KEY=your_project_key

# Self-hosted example (uncomment if using docker-compose profile self-hosted-sonar):
# SONAR_HOST_URL=http://sonarqube:9000
# SONAR_ORGANIZATION=
